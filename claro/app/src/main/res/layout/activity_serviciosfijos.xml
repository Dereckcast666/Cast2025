<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4CAF50"
    android:backgroundTint="#8BC34A"
    tools:context=".serviciosfijos">


    <!-- Opcional: hace que el fondo sea un poco más transparente -->


    <ImageView
        android:id="@+id/fondo_fijo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:alpha="0.9"
        android:scaleType="centerCrop"
        android:src="@drawable/olmo"
        tools:layout_editor_absoluteX="-60dp"
        tools:layout_editor_absoluteY="173dp" />

    <TextView
        android:id="@+id/internetF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#EF3A3A"
        android:fontFamily="@font/cast"
        android:text="Internet Fijo"
        android:textColor="@color/black"
        android:textSize="25sp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="243dp" />

    <TextView
        android:id="@+id/serviciosbtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#EF3A3A"
        android:fontFamily="@font/cast"
        android:text="Servicio al Cliente"
        android:textColor="@color/black"
        android:textSize="25sp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="404dp" />

    <TextView
        android:id="@+id/servicio1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#EF3A3A"
        android:fontFamily="@font/cast"
        android:text="SERVICIOS"
        android:textColor="@color/black"
        android:textSize="35dp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="32dp" />

    <TextView
        android:id="@+id/servicio2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#EF3A3A"
        android:fontFamily="@font/cast"
        android:text="FIJOS"
        android:textColor="@color/black"
        android:textSize="35dp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="238dp"
        tools:layout_editor_absoluteY="32dp" />

    <TextView
        android:id="@+id/Tclaro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#EF3A3A"
        android:fontFamily="@font/cast"
        android:text="Claro TV📡"
        android:textColor="@color/black"
        android:textSize="25sp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="113dp" />


    <Button
        android:id="@+id/clarotvBTN"
        android:layout_width="254dp"
        android:layout_height="74dp"
        android:layout_marginEnd="172dp"
        android:backgroundTint="#3F51B5"
        android:fontFamily="@font/cast"
        android:text="Detalles"
        android:textSize="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="InvalidId,MissingConstraints"
        tools:layout_editor_absoluteY="155dp" />

    <Button
        android:id="@+id/wifiBTN"
        android:layout_width="254dp"
        android:layout_height="74dp"
        android:layout_marginEnd="168dp"
        android:backgroundTint="#3F51B5"
        android:fontFamily="@font/cast"
        android:text="Detalles"
        android:textSize="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="InvalidId,MissingConstraints"
        tools:layout_editor_absoluteY="286dp" />


    <Button
        android:id="@+id/atencionBTN"
        android:layout_width="254dp"
        android:layout_height="74dp"
        android:layout_marginEnd="172dp"
        android:backgroundTint="#3F51B5"
        android:fontFamily="@font/cast"
        android:text="Detalles"
        android:textSize="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="InvalidId,MissingConstraints"
        tools:layout_editor_absoluteY="448dp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:contentDescription="Banner MiClaro"
        android:scaleType="centerCrop"
        android:src="@drawable/qr"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="-10dp"
        tools:layout_editor_absoluteY="535dp" />


</androidx.constraintlayout.widget.ConstraintLayout>