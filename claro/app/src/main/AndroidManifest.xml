<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.claro">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Claro"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Claro">

        <!-- Actividad principal de inicio de sesión -->
        <activity
            android:name=".iniciodesesion"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Otras actividades -->
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".paquetes" android:exported="false" />
        <activity android:name=".lonuevo" android:exported="false" />
        <activity android:name=".Contacto" android:exported="false" />
        <activity android:name=".PromocionesActivity" android:exported="false" />

    </application>

</manifest>

